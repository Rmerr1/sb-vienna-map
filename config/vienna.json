{
  "_comment": "Vienna (VIE) map configuration for Subway Builder / Railyard. Every number here is a tuning knob - edit freely and re-run the relevant script. Coordinates are [longitude, latitude].",
  "map_code": "VIEN",
  "map_name": "Vienna",
  "country": "AT",
  "creator": "Rmerr1",
  "version": "1.0.0",
  "description": "Build the U-Bahn Vienna never got. All 23 districts plus Flughafen Wien-Schwechat.",
  "_bbox_comment": "City limits (Stadtgrenze) extended south-east to include Flughafen Wien-Schwechat, which sits in Lower Austria just outside the city boundary. Roughly 32 km x 27 km.",
  "bbox": [
    16.17,
    48.09,
    16.6,
    48.33
  ],
  "_initial_view_comment": "Stephansplatz - the historic centre and the U1/U3 interchange.",
  "initial_view_state": [
    16.373,
    48.2085
  ],
  "osmpbf": "data/austria-latest.osm.pbf",
  "outputdir": "build",
  "map_generation": {
    "_comment": "Vienna is dense and building-rich. Filter sizes of 20 m2 keep Kleingarten sheds and inner-courtyard outbuildings out of the collision index without losing real structures. Raise to 40 if the buildings index gets too large.",
    "building_index_filter_size": 20,
    "building_tile_filter_size": 20,
    "building_index_simplification": 1,
    "building_tile_simplification": 1,
    "max_building_tile_size": 450,
    "maxzoom": 15,
    "create_building_foundations": true,
    "create_ocean_foundations": true,
    "color_military_like_aerodrome": true,
    "ncores": 8,
    "RAM": 8,
    "_overture_comment": "Depot discovers the newest Overture release from https://stac.overturemaps.org/catalog.json, which now 404s - the catalog moved and depot was not updated. Pinning the release here skips that lookup entirely. Check https://docs.overturemaps.org/release-calendar/ for newer ones; format is yyyy-mm-dd.x. Set to null to try depot's own lookup again.",
    "overture_release": "2026-07-22.0",
    "_buildings_geojson_comment": "Pre-fetched buildings file. When set, depot skips its own DuckDB/S3 fetch entirely - the escape hatch when DuckDB's httpfs layer cannot read Overture's parquet. Fetch raw with: overturemaps download --bbox=16.17,48.09,16.6,48.33 -f geojson --type=building -o ~/vienna/data/buildings.geojson, then run scripts/01a_building_heights.py to produce the file below. Set to null to let depot fetch buildings itself.",
    "buildings_geojson": "~/vienna/data/buildings_with_heights.geojson",
    "_building_heights_comment": "Only ~41% of Overture's Vienna buildings carry a height and ~19% a floor count; depot would flatten the rest to 4 m. Script 01a fills them in: real height first, floors x metres_per_floor second, then the median of nearby buildings that do have one. metres_per_floor of 3.2 suits Vienna's mix of tall Gründerzeit and shorter modern floors. Lower min_samples_per_cell if too many buildings fall back to the city-wide median.",
    "building_heights": {
      "metres_per_floor": 3.2,
      "impute_grid_deg": 0.002,
      "fallback_grid_deg": 0.01,
      "min_samples_per_cell": 3
    },
    "_labels_comment": "Vienna's OSM place tags: 'city' = Wien itself, 'town'/'village' = Lower Austrian settlements just over the border, 'suburb' = the 23 Bezirke (Leopoldstadt, Favoriten...), 'quarter'/'neighbourhood' = Grätzl level (Servitenviertel, Sonnwendviertel...). Run obj.check_labels() after extract_base_data to see actual counts before committing to these.",
    "cities": [
      "city",
      "town"
    ],
    "suburbs": [
      "city",
      "town",
      "suburb",
      "village"
    ],
    "neighborhoods": [
      "suburb",
      "quarter",
      "neighbourhood",
      "borough",
      "hamlet"
    ],
    "_language_comment": "Vienna's OSM data is already German-primary, so leave these null. Set to 'prefer:en' only if you want an English-labelled map.",
    "label_name_language": null,
    "road_name_preferred_language": null
  },
  "demand_generation": {
    "_comment": "Base residents/jobs demand. TARGET_POINTS controls map performance: more points = finer demand but slower routing and a bigger file. 4000-6000 is a good range for a city this size.",
    "grid_resolution_m": 250,
    "target_points": 5000,
    "MAXPOPSIZE": 200,
    "min_flow_size": 8,
    "_top_k_comment": "DEPRECATED - top_k_destinations is no longer used. Pop emission now samples OD pairs in proportion to modelled flow; target_pops sets how many draws, i.e. roughly the pop count. Higher = finer demand, bigger file, slower routing in step 03. sample_seed makes the sampling reproducible.",
    "top_k_destinations": 30,
    "_gravity_comment": "Doubly-constrained gravity model. beta is the distance-decay in the impedance exp(-beta * d_km); 0.16 gives a median commute around 6-7 km, which matches Vienna's actual modal commute. intra_zone_share is the fraction of workers who work in their own cell.",
    "gravity_beta": 0.16,
    "intra_zone_share": 0.08,
    "_employment_comment": "Jobs modelled inside the bbox. Vienna has roughly 900k jobs; ~250k of those are filled by Umland commuters who enter from outside the map, which the outside_connection points below represent instead.",
    "total_jobs": 900000,
    "jobs_from_outside": 250000,
    "routing_method": "osrm",
    "osrm_port": 5000,
    "target_pops": 30000,
    "sample_seed": 20260817
  },
  "_special_demand_comment": "Special demand points. 'type' values must come from depot's taxonomy - print DemandData(...).special_demand_codes.keys() to see the full list. total_capacity is people per day; pop_size is how many people per generated pop; merge_within is the metres within which nearby generated points get merged.",
